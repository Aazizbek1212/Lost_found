# .env — BU FAYL HECH QACHON GIT'GA QO'SHILMASIN (.gitignore'da bor).

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=lostfound
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# AI / Xarita kalitlari (eski kalitlar oshkor bo'lgan — YANGI kalit yarating!)
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
